      "smooth_m": 100,
      "avoid": true,
      "obstacle_dist_m": 20,
      "note": "Flussmitte aus dem OSM-Wasser (alle 40 m Querschnitt), auf den freien Strecken 8 m nach rechts (Nordufer, Rechtsfahrgebot flussab); an Ignatz-Bubis-Brücke, Alter Brücke (Fahrrinne nördlich der Maininsel), Eisernem Steg, Untermain- und Friedensbrücke mittig im Hauptfeld. Start unterhalb der Osthafenbrücke, Ziel kurz nach der Friedensbrücke; eine Haltung (Staustufen Offenbach und Griesheim ausserhalb)",
      "course_texts": {
        "description": {
          "de": "Flussab auf dem Main mitten durch Frankfurt: von der Osthafenbrücke vorbei an EZB und Deutschherrnufer, unter Flößerbrücke und Ignatz-Bubis-Brücke hindurch, nördlich der Maininsel durch die Alte Brücke, dann am Römerberg und Museumsufer entlang unter Eisernem Steg, Untermainbrücke und Holbeinsteg bis zur Friedensbrücke – mit der Skyline der Bankentürme auf der rechten Seite.",
          "en": "Downstream on the river Main through the heart of Frankfurt: from the Osthafenbrücke past the European Central Bank, under the Flößerbrücke and the Ignatz-Bubis-Brücke, through the Alte Brücke (Old Bridge) north of the Maininsel island, then along the Römerberg old town and the Museumsufer (museum embankment) under the Eiserner Steg footbridge, the Untermainbrücke and the Holbeinsteg to the Friedensbrücke, with the bank towers of the skyline on your right."
        },
        "highlights": [
          {
            "name": {
              "de": "Europäische Zentralbank",
              "en": "European Central Bank"
            },
            "side": "rechts",
            "note": {
              "de": "kurz nach dem Start, Doppelturm an der Großmarkthalle",
              "en": "shortly after the start: the twin tower on the former wholesale market hall"
            }
          },
          {
            "name": {
              "de": "Maininsel",
              "en": "Maininsel (river island)"
            },
            "side": "links",
            "note": {
              "de": "an der Alten Brücke, die Fahrt geht nördlich daran vorbei",
              "en": "at the Alte Brücke; the course passes north of it"
            }
          },
          {
            "name": {
              "de": "Dom und Römerberg",
              "en": "Cathedral and Römerberg old town"
            },
            "side": "rechts"
          },
          {
            "name": {
              "de": "Museumsufer Sachsenhausen",
              "en": "Museumsufer, Sachsenhausen"
            },
            "side": "links",
            "note": {
              "de": "Städel und weitere Museen am Schaumainkai",
              "en": "the Städel and other museums along the Schaumainkai"
            }
          },
          {
            "name": {
              "de": "Skyline mit Main Tower und Commerzbank-Tower",
              "en": "Skyline with the Main Tower and the Commerzbank Tower"
            },
            "side": "rechts",
            "note": {
              "de": "hinter Untermainbrücke und Nizza-Ufer",
              "en": "behind the Untermainbrücke and the Nizza gardens"
            }
          }
        ],
        "bridges": [
          "Deutschherrnbrücke",
