            "state": "translated",
            "value": "Save to Apple Health"
          }
        }
      }
    },
    "In den letzten harten Einheiten warst du oft deutlich langsamer als das Ziel oder am Anschlag. Du kannst die Schwelle um 3 % senken.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your recent hard sessions you were often well below the target pace or at your limit. You can lower your threshold by 3 %."
          }
        }
      }
    },
    "In den letzten harten Einheiten warst du oft deutlich langsamer als das Ziel oder am Anschlag. Ein Test klärt die Schwelle – oder du senkst sie um 3 %.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your recent hard sessions you were often well below the target pace or at your limit. A test settles your threshold – or you lower it by 3 %."
          }
        }
      }
    },
    "In den letzten Schwellen-Einheiten warst du klar über dem Ziel, bei niedrigem Puls. Ein Test zeigt, ob deine Schwelle gestiegen ist.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your recent threshold sessions you were clearly above the target at a low heart rate. A test shows whether your threshold has gone up."
          }
        }
      }
    },
