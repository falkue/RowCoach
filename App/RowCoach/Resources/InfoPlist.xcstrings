{
  "sourceLanguage": "de",
  "version": "1.0",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RowCoach verbindet sich mit dem Rudergerät (Concept2-PM5 oder Bluetooth FTMS) und dem Pulsgurt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RowCoach connects to your rowing machine (Concept2 PM5 or Bluetooth FTMS) and your heart rate strap."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RowCoach liest Trainings und Puls, um deine Einheiten auszuwerten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RowCoach reads workouts and heart rate to analyse your sessions."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RowCoach speichert deine Rudereinheiten als Training in Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RowCoach saves your rowing sessions as workouts in Apple Health."
          }
        }
      }
    }
  }
}
